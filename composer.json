{
    "name": "26b/laravel-invitations",
    "description": "Laravel package to invite users",
    "type": "library",
    "require": {
        "php": "^8.3",
        "spatie/laravel-package-tools": "^1.93"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "TwentySixB\\LaravelInvitations\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TwentySixB\\LaravelInvitations\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "26B",
            "email": "hello@26b.io"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "TwentySixB\\LaravelInvitations\\InvitationsServiceProvider"
            ]
        }
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
